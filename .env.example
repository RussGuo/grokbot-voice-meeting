# Copy to .env and fill in. Never commit .env.
# `meet doctor` reports which of these are set. It does not print the values.

# --- LiveKit Cloud (free Build plan is enough to start) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice-meeting

# --- Speech. Default is Volcengine Doubao. Leave blank to use local sherpa (extra `local`) or set openai. ---
# VOICE_ASR_PROVIDER=auto          # auto | volc | aliyun | openai | local
# VOICE_TTS_PROVIDER=auto
VOLC_API_KEY=
# VOLC_APP_ID=
# VOLC_ACCESS_TOKEN=
# VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_ASR_HOTWORDS=议程,行动项,纪要
# DASHSCOPE_API_KEY=               # only if VOICE_*_PROVIDER=aliyun (adapter is a stub)
# OPENAI_API_KEY=                  # VOICE_*_PROVIDER=openai (Whisper + OpenAI TTS)
# OPENAI_BASE_URL=
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1

# Voice catalog override (speaker ids). Default: config/voices.json
# VOICE_CATALOG=config/voices.json

# --- LLM. DeepSeek is the default. Any OpenAI-compatible endpoint works. ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# LLM_PROVIDER=auto                # auto | deepseek | openai | mock
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Who is in the room ---
MEETING_HUMAN_IDENTITY=host
MEETING_HUMAN_NAME=You
MEETING_LANG=zh                    # zh | en
MEETING_MODERATOR_ID=moderator
# MEETING_MODERATOR_NAME=Host
# MEETING_MODERATOR_MODE=neutral   # only for the built-in sample scenarios

# --- In-meeting questions to the real bot (slow path) ---
# MEETING_PRINCIPAL=defer          # defer | mock | file | webhook. Unset: defer for `meet` meetings, mock for samples
# MEETING_PRINCIPAL_DIR=runs/principal
# MEETING_PRINCIPAL_WEBHOOK=https://example.invalid/principal
# MEETING_PRINCIPAL_DELAY_MS=20000
# MEETING_PRINCIPAL_INLINE_MS=5000   # wait this long for the principal inside the same turn; 0 turns it off (file/webhook only)
# MEETING_PRINCIPAL_MOCK_INLINE=1    # let the mock principal answer in-turn too (to rehearse the fast path)

# --- Join page. Static UI, no tunnel. Falls back to meet.livekit.io when unset. ---
# MEETING_JOIN_PAGE=https://yourname.github.io/grokbot-voice-meeting/web/index.html

# Optional token server (web/token_server.py). Not required when using the pre-signed link.
# WEB_HOST=127.0.0.1
# WEB_PORT=8787
# MEETING_ACCESS_KEY=              # public mode: send as "Authorization: Bearer <key>" (?k= works but is discouraged)

# Bot registry path. Default: ./bots.yaml
# MEETING_BOTS=
# MEETING_JOIN_WAIT_S=1800         # how long the worker waits for the human before ending the run as NoShow
# MEETING_SCORER=rule              # rule | llm (async LLM re-scorer for raised hands)
# MEETING_FOLLOWUP_WEBHOOK=        # default --push URL for `meet followup`
# MEETING_RUN_ID=                  # fix the run id; default <room>-<YYYYmmdd-HHMMSS>
# MEETING_BRIEF_CACHE=
# MEETING_TRANSPORT=livekit
# MEETING_HOME=
